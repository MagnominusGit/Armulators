// The app's names, from app.cmake.

#ifndef ARMGBA_FRONTEND_APP_INFO_H
#define ARMGBA_FRONTEND_APP_INFO_H

#define APP_ID "@APP_ID@"
#define APP_NAME "@APP_NAME@"
#define APP_WORDMARK "@APP_WORDMARK@"
// The Java classes' path for JNI, from the package.
#define APP_JAVA_PATH "@APP_JAVA_PATH@"
#define APP_JAVA_CLASS "@APP_JAVA_CLASS@"
// The console's screen, for the window's size before a game gives its own.
#define APP_WINDOW_WIDTH @APP_WINDOW_WIDTH@
#define APP_WINDOW_HEIGHT @APP_WINDOW_HEIGHT@

// The game list's files, and the games looked for inside an archive (as libretro-common lists them).
#define APP_EXTENSIONS @APP_EXTENSION_LIST@
#define APP_ARCHIVED "@APP_ARCHIVED_LIST@"
// The systems: their keys, names, and the folder names each is found by in the Games folder.
#define APP_SYSTEM_COUNT @APP_SYSTEM_COUNT@
#define APP_SYSTEM_KEYS @APP_SYSTEM_KEY_LIST@
#define APP_SYSTEM_NAMES @APP_SYSTEM_NAME_LIST@
#define APP_SYSTEM_FOLDERS @APP_SYSTEM_FOLDER_LIST@
// Help texts that name the console's buttons and what the app draws over its picture.
#define APP_HELP_SWAP "@APP_HELP_SWAP@"
#define APP_HELP_SHADERS "@APP_HELP_SHADERS@"

#endif
