package @APP_JAVA_PACKAGE@;

import java.io.ByteArrayOutputStream;
import java.io.FileOutputStream;
import java.io.IOException;
import java.io.InputStream;
import java.io.OutputStream;
import java.net.HttpURLConnection;
import java.net.URL;

// RetroAchievements' requests on Android, which has no libcurl, through its own HTTPS; called from
// the achievements' worker thread (app/cheevos.c). And downloads to a file (app/http.c).
public final class Http {
	private Http() {
	}

	// The answer's body, with its HTTP code in status[0], or null when the server can't be reached.
	public static byte[] fetch(String url, byte[] post, String contentType, String userAgent, int[] status) {
		HttpURLConnection connection = null;
		try {
			connection = (HttpURLConnection) new URL(url).openConnection();
			connection.setConnectTimeout(30000);
			connection.setReadTimeout(30000);
			connection.setInstanceFollowRedirects(true);
			connection.setRequestProperty("User-Agent", userAgent);
			if (post != null) {
				connection.setDoOutput(true);
				connection.setRequestMethod("POST");
				connection.setRequestProperty("Content-Type", contentType);
				connection.setFixedLengthStreamingMode(post.length);
				OutputStream out = connection.getOutputStream();
				out.write(post);
				out.close();
			}
			status[0] = connection.getResponseCode();
			InputStream in = status[0] >= 400 ? connection.getErrorStream() : connection.getInputStream();
			ByteArrayOutputStream body = new ByteArrayOutputStream();
			if (in != null) {
				byte[] buffer = new byte[8192];
				for (int n; (n = in.read(buffer)) > 0;) {
					body.write(buffer, 0, n);
				}
				in.close();
			}
			return body.toByteArray();
		} catch (IOException e) {
			return null;
		} finally {
			if (connection != null) {
				connection.disconnect();
			}
		}
	}

	// Writes the answer's body to path as it arrives, with its HTTP code in status[0] (and with room,
	// the KiB written so far in status[1] and in all in status[2]): true once it's all written, with
	// code 200.
	public static boolean download(String url, String path, String userAgent, int[] status) {
		HttpURLConnection connection = null;
		try {
			connection = (HttpURLConnection) new URL(url).openConnection();
			connection.setConnectTimeout(30000);
			connection.setReadTimeout(60000);
			connection.setInstanceFollowRedirects(true);
			connection.setRequestProperty("User-Agent", userAgent);
			status[0] = connection.getResponseCode();
			if (status[0] != 200) {
				return false;
			}
			// The KiB in all, and so far as they're written, which the app reads for its progress bar
			if (status.length > 2) {
				status[2] = (int) (connection.getContentLengthLong() / 1024);
			}
			InputStream in = connection.getInputStream();
			FileOutputStream out = new FileOutputStream(path);
			try {
				byte[] buffer = new byte[65536];
				long written = 0;
				for (int n; (n = in.read(buffer)) > 0;) {
					out.write(buffer, 0, n);
					written += n;
					if (status.length > 1) {
						status[1] = (int) (written / 1024);
					}
				}
			} finally {
				out.close();
				in.close();
			}
			return true;
		} catch (IOException e) {
			return false;
		} finally {
			if (connection != null) {
				connection.disconnect();
			}
		}
	}
}
